# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Database (Turso). Leave empty locally to use .data/local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# File uploads (Vercel Blob). Created automatically when you connect a Blob store in Vercel.
# Leave empty locally to store uploads in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Authorized administrator email. No public self-registration.
ADMIN_EMAILS=ohridski@gmail.com
ADMIN_PAROLA_HASH=Kliment-demo-70a352
# SHA-256 digest of a random 32-byte activation token (hex).
# The original token is handed to the owner only, never stored in source.
ADMIN_SETUP_HASH=
# Expiry as Unix milliseconds; setup is also disabled after the account exists.
ADMIN_SETUP_EXPIRES=
