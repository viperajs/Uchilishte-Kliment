# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Supabase (database, administrator sign-in and uploaded files). Supabase → Project Settings → API Keys / Data API.
# The Vercel ↔ Supabase integration sets these too (SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work).
SUPABASE_URL=https://axclatsdigwesiwinrqg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NivumHdc7w-CLM4NLxhRWA_9I0OW9Mq
# Secret key: full access to the data. Server only; never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Only for `npm run db:push` (applies supabase/migrations). Supabase → Connect → Session pooler.
SUPABASE_DB_URL=

# Authorized administrator email. No public self-registration.
ADMIN_EMAILS=ohridski@gmail.com
# SHA-256 digest of a random 32-byte activation token (hex).
# The original token is handed to the owner only, never stored in source.
ADMIN_SETUP_HASH=
# Expiry as Unix milliseconds; setup is also disabled after the account exists.
ADMIN_SETUP_EXPIRES=
